# Deployment Private Key (for deploying contracts)
PRIVATE_KEY=your_private_key_here

# Arc Testnet Configuration
ARC_TESTNET_RPC_URL=https://arc-testnet.drpc.org
NEXT_PUBLIC_ARC_CHAIN_ID=5042002

# Contract Address (after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Circle Wallets
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_ENTITY_SECRET=your_circle_entity_secret

# Demo Wallet Private Keys (for testing)
HOMEOWNER_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=
INSPECTOR_SOLANA_PRIVATE_KEY=
ARBITRATOR_PRIVATE_KEY=

# Bridge Kit
BRIDGE_KIT_ENV=testnet
